# Ghidra project (binary DBs, regenerated locally — not source of truth)
ghidra_project/

# Firmware you supply (see README.md "Firmware you supply"); default dir, overridable
# with $ICOM_FW_DIR. Never commit Icom firmware/manuals.
/firmware

# Extracted/regenerated firmware artifacts (large binaries, reproducible from
# tools/ against your own firmware under $ICOM_FW_DIR)
scratch/
*.dat
*.ttf
!tools/**/*.dat

# Python
__pycache__/
*.pyc
.venv/
.claude/settings.local.json

# Vendored QEMU checkout + build output + generated flash images
# (qemu-machine/setup.sh recreates the checkout; qemu-machine/tools/build_flash.py
# recreates the flash image from a real container -- see qemu-machine/README.md)
qemu-machine/qemu-src/
qemu-machine/flash.bin
qemu-machine/riic2_eeprom.img

+/*
+ * rza1h_irq_trace() -- TEMPORARY diagnostic instrumentation, not a permanent
+ * part of upstream QEMU. See qemu-machine/patches/irq-mask-trace.patch and
+ * qemu-machine/README.md's Status section for why this exists (chasing what
+ * holds CPSR.I=1 for ~10s during a specific IC-7300 firmware boot stall) and
+ * why it's a direct C-level hook rather than GDB/polling-based tracing
+ * (those were shown to suppress the exact effect being chased). Logs only on
+ * an actual 0->1/1->0 transition of the I bit -- both call sites below are
+ * the *only* two places in target/arm that ever change it (confirmed by
+ * grepping every env->daif writer), so this needs no per-instruction
+ * filtering. Silent unless RZA1H_IRQ_TRACE is set in the environment.
+ */
+static void rza1h_irq_trace(CPUARMState *env, const char *via)
+{
+    static int enabled = -1;
+    static uint32_t last_i = 0xffffffff; /* sentinel: not yet observed */
+
+    if (enabled < 0) {
+        const char *e = getenv("RZA1H_IRQ_TRACE");
+        enabled = (e && *e) ? 1 : 0;
+    }
+    if (!enabled) {
+        return;
+    }
+
+    uint32_t cur_i = env->daif & CPSR_I;
+    if (last_i == 0xffffffff) {
+        last_i = cur_i;
+        return; /* don't log the initial (arbitrary) state as a transition */
+    }
+    if (cur_i != last_i) {
+        fprintf(stderr,
+                "[irqtrace] t=%" PRId64 "us I %s pc=0x%08x mode=0x%02x via=%s\n",
+                (int64_t)g_get_monotonic_time(), cur_i ? "SET" : "CLR",
+                env->regs[15], env->uncached_cpsr & CPSR_M, via);
+        last_i = cur_i;
+    }
+}
